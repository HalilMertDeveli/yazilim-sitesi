@page
@model ErrorModel
@{
    ViewData["Title"] = Model.IsNotFound ? "Sayfa bulunamadı · Page not found — Halil Mert Develi" : "Bir şeyler ters gitti · Something went wrong — Halil Mert Develi";
    ViewData["Description"] = "Halil Mert Develi";
}
<main id="main" class="error-page">
    <div class="container error-page__inner">
        <p class="eyebrow">@(Model.IsNotFound ? "404" : "Hata · Error")</p>
        <h1 class="section-title">
            @(Model.IsNotFound ? "Bu sayfa yok." : "Sayfa yüklenemedi.")
            <span class="error-page__en" lang="en">@(Model.IsNotFound ? "This page doesn't exist." : "The page could not be loaded.")</span>
        </h1>
        @if (Model.ShowRequestId)
        {
            <p class="error-page__id">Request ID: <code>@Model.RequestId</code></p>
        }
        <div class="hero__actions">
            <a class="btn btn--primary" href="/">Ana sayfa</a>
            <a class="btn btn--ghost" href="/en" lang="en">Home (EN)</a>
        </div>
    </div>
</main>
