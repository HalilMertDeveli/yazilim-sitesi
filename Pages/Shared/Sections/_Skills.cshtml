@model IndexModel
<section id="skills" class="section" aria-labelledby="skills-title">
    <div class="container">
        <header class="section-head" data-reveal>
            <p class="eyebrow"><span class="eyebrow__index">04</span>@Model.T("Yetkinlikler", "Skills")</p>
            <h2 id="skills-title" class="section-title">@Model.T("Disipline göre teknolojiler", "Technology, grouped by discipline")</h2>
            <p class="section-lead">@Model.T("Yalnızca projelerimde gerçekten kullandıklarım.", "Only what I've actually used in my projects.")</p>
        </header>

        <div class="skill-grid">
            @foreach (var group in PortfolioContent.Skills)
            {
                <section class="skill" data-reveal aria-label="@Model.T(group.Title)">
                    <h3 class="skill__title">@Model.T(group.Title)</h3>
                    <p class="skill__caption">@Model.T(group.Caption)</p>
                    <ul class="skill__list">
                        @foreach (var item in group.Items)
                        {
                            <li>@item</li>
                        }
                    </ul>
                </section>
            }
        </div>
    </div>
</section>
