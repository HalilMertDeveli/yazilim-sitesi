@model CaseStudyView
@{
    var vm = Model.Page;
    var s = Model.Study;
    var total = PortfolioContent.CaseStudies.Count;
}
<article id="@s.Id" class="product" style="--case: var(@s.Accent)" aria-labelledby="@s.Id-title" data-product>
    <div class="product__ghost" aria-hidden="true">@s.Name</div>

    <div class="container product__grid">
        <div class="product__copy" data-reveal>
            <p class="product__index">0@(Model.Index) <span>/ 0@(total)</span></p>
            <h3 id="@s.Id-title" class="product__name">@s.Name</h3>
            <ul class="badges" aria-label="@vm.T("Durum", "Status")">
                @foreach (var badge in s.Statuses)
                {
                    <li class="badge @vm.ToneClass(badge.Tone)">@if (badge.Tone == StatusTone.Private) { @Icons.Lock }@vm.T(badge.Label)</li>
                }
            </ul>
            <p class="product__tagline">@vm.T(s.Tagline)</p>

            <ul class="metrics">
                @foreach (var metric in s.Metrics)
                {
                    <li>
                        <span class="metrics__value"><span data-count="@metric.Value">@vm.FormatNumber(metric.Value)</span>@metric.Suffix</span>
                        <span class="metrics__label">@vm.T(metric.Label)</span>
                    </li>
                }
            </ul>

            <ul class="chips chips--sm" aria-label="@vm.T("Teknolojiler", "Stack")">
                @foreach (var tech in s.Stack)
                {
                    <li>@tech</li>
                }
            </ul>

            <div class="product__actions">
                <button class="btn btn--primary btn--sm" type="button" data-open="sheet-@s.Id">@vm.T("Mühendislik detayları", "Engineering details") @Icons.ArrowRight</button>
                @foreach (var link in s.Links)
                {
                    <a class="btn btn--ghost btn--sm" href="@link.Url" target="_blank" rel="noopener">@vm.T(link.Label) @Icons.ArrowUpRight</a>
                }
            </div>
        </div>

        <div class="product__demo" data-reveal>
            <partial name="@("Sections/" + s.Demo)" model="vm" />
        </div>
    </div>

    <dialog id="sheet-@s.Id" class="sheet" aria-labelledby="sheet-@s.Id-title">
        <div class="sheet__bar">
            <p class="sheet__kicker">@vm.T("Mühendislik detayları", "Engineering details")</p>
            <button class="sheet__close" type="button" data-close aria-label="@vm.T("Kapat", "Close")">×</button>
        </div>
        <h3 id="sheet-@s.Id-title" class="sheet__title">@s.Name</h3>

        <dl class="case__facts">
            <div>
                <dt>@vm.T("Problem", "Problem")</dt>
                <dd>@vm.T(s.Problem)</dd>
            </div>
            <div>
                <dt>@vm.T("Katkım", "My contribution")</dt>
                <dd>@vm.T(s.Contribution)</dd>
            </div>
        </dl>

        <h4 class="case__subhead">@vm.T("Mühendislik", "Engineering highlights")</h4>
        <ul class="highlights">
            @foreach (var h in s.Highlights)
            {
                <li>
                    <strong>@vm.T(h.Title)</strong>
                    <span>@vm.T(h.Body)</span>
                </li>
            }
        </ul>

        @if (s.Implemented.Count > 0)
        {
            <div class="progress-split">
                <div>
                    <h4 class="case__subhead">@vm.T("Hazır olanlar", "Built so far")</h4>
                    <ul class="checklist">
                        @foreach (var item in s.Implemented)
                        {
                            <li class="is-done">@Icons.Check<span>@vm.T(item)</span></li>
                        }
                    </ul>
                </div>
                <div>
                    <h4 class="case__subhead">@vm.T("Yol haritası", "On the roadmap")</h4>
                    <ul class="checklist">
                        @foreach (var item in s.Roadmap)
                        {
                            <li class="is-planned">@Icons.Circle<span>@vm.T(item)</span></li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (s.PrivateNote is not null)
        {
            <p class="case__private">@Icons.Lock <span>@vm.T(s.PrivateNote)</span></p>
        }
    </dialog>
</article>
