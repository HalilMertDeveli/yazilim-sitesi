@model IndexModel
@{
    var projects = PortfolioContent.ClaudeProjects;
    var total = PortfolioContent.ClaudeCommitTotal;
    var max = projects.Max(p => p.Commits);
    var width = projects.Max(p => Model.T(p.Name).Length) + 2;
}
<section id="claude" class="section section--claude" aria-labelledby="claude-title">
    <div class="container">
        <header class="section-head" data-reveal>
            <p class="eyebrow"><span class="eyebrow__index">01</span>@Model.T("Claude ile birlikte", "Together with Claude")</p>
            <h2 id="claude-title" class="section-title">@Model.T("Claude ile birlikte geliştirdiklerim", "What I've built with Claude")</h2>
            <p class="section-lead">
                @Model.T(
                    "En büyük ürünlerimi Claude ile eşli programlayarak geliştiriyorum. Aşağıdaki sayılar tahmin değil: GitHub geçmişimdeki Claude ortak imzalı commit'lerden sayıldı.",
                    "I build my largest products pair-programming with Claude. These numbers aren't estimates: they're counted from the commits in my GitHub history that Claude co-signed.")
            </p>
        </header>

        <div class="claude" data-reveal>
            <div class="term" role="group" aria-label="@Model.T("Commit sayıları", "Commit counts")" data-terminal>
                <div class="term__bar" aria-hidden="true"><span></span><span></span><span></span><code>~/github</code></div>
                <div class="term__body">
                    <span class="term__cmd" data-line data-typed>$ git log --grep="Co-Authored-By: Claude" --oneline | wc -l</span>
                    @foreach (var p in projects)
                    {
                        <span class="term__row" data-line>@(Model.T(p.Name).PadRight(width, '.')) @p.Commits.ToString().PadLeft(4)</span>
                    }
                    <span class="term__total" data-line>@(Model.T("toplam", "total").PadRight(width, '.')) @total.ToString().PadLeft(4)</span>
                </div>
            </div>

            <div class="claude__list">
                <p class="claude__total">
                    <span class="claude__number" data-count="@total">@Model.FormatNumber(total)</span>
                    <span class="claude__caption">@Model.T("Claude ortak imzalı commit", "commits co-signed by Claude")</span>
                </p>
                <ul class="repo-bars">
                    @foreach (var p in projects)
                    {
                        var external = p.Href.StartsWith("http");
                        <li style="--w:@((p.Commits * 100 / max).ToString())%">
                            <a href="@p.Href" target="@(external ? "_blank" : null)" rel="@(external ? "noopener" : null)">
                                <span class="repo-bars__name">@Model.T(p.Name) @if (p.IsPrivate) { @Icons.Lock }</span>
                                <span class="repo-bars__count">@Model.FormatNumber(p.Commits)</span>
                                <span class="repo-bars__summary">@Model.T(p.Summary)</span>
                                <span class="repo-bars__track" aria-hidden="true"><span></span></span>
                            </a>
                        </li>
                    }
                </ul>
                <p class="claude__note">@Model.T("30 Ekim 2026 itibarıyla, depoların varsayılan dalları. Kilitli depolar özel; kaynak kodları herkese açık değil.", "As of 30 October 2026, on each repository's default branch. Locked repositories are private, so their source isn't public.")</p>
            </div>
        </div>
    </div>
</section>
