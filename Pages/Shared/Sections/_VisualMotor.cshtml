@model IndexModel
<figure class="viz viz--motor" data-tilt>
    <div class="viz__stage">
        <div class="browser">
            <div class="browser__bar" aria-hidden="true"><span></span><span></span><span></span></div>
            <img src="/img/projects/motor-store.webp" width="800" height="500" loading="lazy" decoding="async"
                 alt="@Model.T("Motor e-ticaret sitesinin ana sayfası: Yola hakim ol başlığı", "Home page of the Motor e-commerce site with a motorcycle hero")" />
        </div>

        <div class="float-card float-card--fitment" aria-hidden="true">
            <p class="float-card__label">@Model.T("Uyumlu parça", "Fitment")</p>
            <ol class="fitment">
                <li>@Model.T("Marka", "Make")</li>
                <li>Model</li>
                <li>@Model.T("Yıl", "Year")</li>
            </ol>
        </div>
    </div>
    <figcaption class="viz__caption">@Model.T("Arayüz görünümü; fiyatlar ve görseller örnektir.", "Interface view; prices and images are placeholders.")</figcaption>
</figure>
