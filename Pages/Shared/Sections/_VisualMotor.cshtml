@model IndexModel
<figure class="viz viz--motor" data-tilt>
    <div class="viz__stage">
        <div class="browser">
            <div class="browser__bar" aria-hidden="true"><span></span><span></span><span></span><code>motor-vitrin.vercel.app</code></div>
            <img src="/img/projects/motor-vitrin.webp" width="800" height="500" loading="lazy" decoding="async"
                 alt="@Model.T("Motor mağazası vitrin prototipi: Yola hakim ol başlıklı ana sayfa", "Motor store prototype: home page with a motorcycle hero")" />
        </div>

        <div class="float-card float-card--fitment" aria-hidden="true">
            <p class="float-card__label">@Model.T("Uyumlu parça", "Fitment")</p>
            <ol class="fitment">
                <li>@Model.T("Marka", "Make")</li>
                <li>Model</li>
                <li>@Model.T("Yıl", "Year")</li>
            </ol>
        </div>
    </div>
    <figcaption class="viz__caption">@Model.T("Statik vitrin prototipi; fiyatlar ve görseller örnektir.", "Static storefront prototype; prices and images are placeholders.")</figcaption>
</figure>
