@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    var publicBase = (Configuration["Site:PublicBaseUrl"] ?? "https://halilmertdeveli.com.tr").TrimEnd('/');
    var lang = ViewData["Lang"] as string ?? "tr";
    var isEn = lang == "en";
    var title = ViewData["Title"] as string ?? "Halil Mert Develi";
    var description = ViewData["Description"] as string ?? "";
    var canonical = ViewData["Canonical"] as string ?? $"{publicBase}/";
    var ogImage = $"{publicBase}/img/og-image.png";
    var jsonLd = ViewData["JsonLd"] as string;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>document.documentElement.classList.add("js")</script>
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="author" content="Halil Mert Develi" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0b0d" />
    <link rel="canonical" href="@canonical" />
    <link rel="alternate" hreflang="tr" href="@publicBase/" />
    <link rel="alternate" hreflang="en" href="@publicBase/en" />
    <link rel="alternate" hreflang="x-default" href="@publicBase/" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Halil Mert Develi" />
    <meta property="og:locale" content="@(isEn ? "en_US" : "tr_TR")" />
    <meta property="og:locale:alternate" content="@(isEn ? "tr_TR" : "en_US")" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Halil Mert Develi — Software Engineer" />
    <meta property="profile:first_name" content="Halil Mert" />
    <meta property="profile:last_name" content="Develi" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
    <link rel="preload" as="image" href="@PortfolioPortrait" fetchpriority="high" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(jsonLd))
    {
        <script type="application/ld+json">@Html.Raw(jsonLd)</script>
    }
</head>
<body>
    <a class="skip-link" href="#main">@(isEn ? "Skip to content" : "İçeriğe geç")</a>
    @RenderBody()
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@functions {
    private const string PortfolioPortrait = Portfolio.Services.PortfolioContent.Portrait;
}
