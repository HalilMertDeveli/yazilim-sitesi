@page
@model IndexModel
@{
    ViewData["Title"] = "Yazılım Geliştirici · CV";
    var repoIndex = 0;
}

<div class="fx-root" aria-hidden="true">
    <div class="fx-aurora fx-aurora--a"></div>
    <div class="fx-aurora fx-aurora--b"></div>
    <div class="fx-noise"></div>
    <canvas class="fx-particles" data-particles></canvas>
    <div class="fx-cursor" data-cursor></div>
    <div class="fx-progress" data-progress></div>
</div>

<header class="site-nav" data-nav>
    <a class="site-nav__brand" href="#ust" data-magnetic>
        <span class="brand-mark"></span>
        Halil Mert Develi
    </a>
    <button class="site-nav__toggle" type="button" aria-expanded="false" aria-controls="site-menu" data-nav-toggle>
        <span class="sr-only">Menü</span>
        <span></span><span></span>
    </button>
    <nav id="site-menu" class="site-nav__links" aria-label="Sayfa bölümleri">
        <a href="#hakkimda">Hakkımda</a>
        <a href="#deneyim">Deneyim</a>
        <a href="#projeler">Projeler</a>
        <a href="#github">Repositories</a>
        <a href="#one-cikan">Öne çıkan</a>
        <a href="#iletisim">İletişim</a>
    </nav>
</header>

<main id="icerik">
    <section id="ust" class="hero" aria-label="Giriş">
        <div class="hero__plane" aria-hidden="true">
            <div class="hero__glow hero__glow--a"></div>
            <div class="hero__glow hero__glow--b"></div>
            <div class="hero__glow hero__glow--c"></div>
            <div class="hero__grid"></div>
            <svg class="hero__circuit" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" role="img">
                <title>Soyut kod ve bağlantı görseli</title>
                <path class="circuit-line" d="M80 120 H340 L420 200 H760 L840 120 H1120" />
                <path class="circuit-line circuit-line--delay" d="M60 640 H280 L360 520 H620 L700 640 H1140" />
                <path class="circuit-line circuit-line--slow" d="M200 40 V280 L320 400 V760" />
                <path class="circuit-line" d="M980 40 V220 L860 340 V720" />
                <circle cx="420" cy="200" r="6" class="circuit-node" />
                <circle cx="760" cy="200" r="6" class="circuit-node circuit-node--delay" />
                <circle cx="360" cy="520" r="6" class="circuit-node" />
                <circle cx="620" cy="520" r="6" class="circuit-node circuit-node--slow" />
                <rect x="520" y="300" width="160" height="96" rx="4" class="circuit-chip" />
                <text x="540" y="356" class="circuit-label">.NET 8</text>
            </svg>
            <div class="hero__scan"></div>
        </div>

        <div class="hero__content">
            <p class="hero__kicker reveal" data-reveal>
                <span class="pulse-dot"></span>
                Yazılım · .NET · Flutter · Mobil
            </p>
            <p class="hero__brand reveal" data-reveal data-split>Halil Mert Develi</p>
            <h1 class="hero__headline reveal" data-reveal>
                <span class="type-line" data-type words="Mevora, mobil ve .NET bir arada.|Yazılım işlerimin vitrini.|Flutter’dan ledger’a kadar."></span>
            </h1>
            <p class="hero__lede reveal" data-reveal>
                Sadece ASP.NET değil — Mevora, Flutter / Kotlin mobil uygulamalar ve saha yazılımları da burada.
                Tek sayfalık koyu temalı yazılım CV’m.
            </p>
            <div class="hero__actions reveal" data-reveal>
                <a class="btn btn--primary" href="#projeler" data-magnetic>Projelerime bak</a>
                <a class="btn btn--ghost" href="#iletisim" data-magnetic>İletişime geç</a>
            </div>
            <div class="hero__stats reveal" data-reveal>
                <div>
                    <strong data-count="@Model.PublicRepoCount">0</strong>
                    <span>Açık repo</span>
                </div>
                <div>
                    <strong data-count="@Model.Repos.Count">0</strong>
                    <span>Vitrinde</span>
                </div>
                <div>
                    <strong data-count="@Model.LanguageStats.Count">0</strong>
                    <span>Ana dil</span>
                </div>
            </div>
        </div>
    </section>

    <div class="marquee" aria-hidden="true">
        <div class="marquee__track">
            <span>Mevora</span><span>Flutter</span><span>Kotlin</span><span>ASP.NET Core</span><span>ClearPay</span><span>LED</span><span>SQL Ledger</span><span>Docker</span>
            <span>Mevora</span><span>Flutter</span><span>Kotlin</span><span>ASP.NET Core</span><span>ClearPay</span><span>LED</span><span>SQL Ledger</span><span>Docker</span>
        </div>
    </div>

    <section id="hakkimda" class="section section--about">
        <div class="section__inner">
            <p class="section__eyebrow reveal" data-reveal>Hakkımda · CV</p>
            <h2 class="section__title reveal" data-reveal>Merhaba — ben Halil Mert Develi.</h2>
            <p class="section__copy reveal" data-reveal>
                İstanbul’da yaşayan bir yazılım geliştiriciyim. Omurgam <strong>ASP.NET Core</strong>; yanında
                <strong>Flutter</strong> ve Kotlin ile mobil, Colorlight ekosisteminde LED / teknik destek işleri var.
                Temiz mimari, okunaklı C# ve “canlıya alınabilir” ürün peşindeyim.
            </p>
            <p class="section__copy reveal" data-reveal>
                GitHub’da ~@Model.PublicRepoCount açık repo bıraktım: öğrenme serilerinden Softtech / Intertech mülakatında
                savunduğum <em>ClearPay</em> cüzdanına, bitirme projem <em>Task Management</em>’a ve saha LED yazılımlarına kadar.
                Bu sayfa o geçmişin CV özeti — sana ulaşmak isteyenler ne yaptığımı buradan görsün.
            </p>
            <dl class="facts">
                <div class="reveal" data-reveal>
                    <dt>Konum</dt>
                    <dd>İstanbul, Türkiye</dd>
                </div>
                <div class="reveal" data-reveal>
                    <dt>Ana odak</dt>
                    <dd>ASP.NET Core · SQL · API</dd>
                </div>
                <div class="reveal" data-reveal>
                    <dt>Mobil &amp; saha</dt>
                    <dd>Flutter · Kotlin · LED</dd>
                </div>
            </dl>
        </div>
    </section>

    <section id="deneyim" class="section section--skills">
        <div class="section__inner">
            <p class="section__eyebrow reveal" data-reveal>GitHub analizi</p>
            <h2 class="section__title reveal" data-reveal>Repolardaki dil dağılımı</h2>
            <p class="section__copy reveal" data-reveal>
                @@HalilMertDeveli hesabındaki public repolardan çıkarılan özet@(Model.ReposFromApi ? " (canlı)" : "").
                C# baskın; Flutter/Dart ve Kotlin mobil tarafta görünür.
            </p>

            <div class="lang-bars reveal" data-reveal>
                @foreach (var lang in Model.LanguageStats)
                {
                    <div class="lang-bar">
                        <div class="lang-bar__label">
                            <span>@lang.Name</span>
                            <span>@lang.Count repo · %@lang.Percent</span>
                        </div>
                        <div class="lang-bar__track">
                            <span class="lang-bar__fill" data-bar-width="@lang.Percent"></span>
                        </div>
                    </div>
                }
            </div>

            <ul class="skill-rail" style="margin-top: 2.5rem">
                <li class="reveal" data-reveal>C# / .NET 8</li>
                <li class="reveal" data-reveal>ASP.NET Core</li>
                <li class="reveal" data-reveal>Flutter</li>
                <li class="reveal" data-reveal>Mobil (Kotlin / Dart)</li>
                <li class="reveal" data-reveal>EF Core / SQL</li>
                <li class="reveal" data-reveal>Identity &amp; JWT</li>
                <li class="reveal" data-reveal>Onion / N-Layer</li>
                <li class="reveal" data-reveal>Docker &amp; CI</li>
            </ul>
        </div>
    </section>

    <section id="projeler" class="section section--work">
        <div class="section__inner">
            <p class="section__eyebrow reveal" data-reveal>Projeler</p>
            <h2 class="section__title reveal" data-reveal>Yazılım işlerimin toplandığı yer</h2>
            <p class="section__copy reveal" data-reveal>
                .NET, Flutter, Kotlin, ürün — hepsi bir arada. Mevora ve mobil uygulamalar da vitrinde.
            </p>

            <div class="stack-tabs reveal" data-reveal aria-hidden="true">
                <span>Mevora</span>
                <span>Flutter</span>
                <span>Kotlin</span>
                <span>ASP.NET Core</span>
                <span>LED</span>
            </div>

            <div class="project-board">
                <article class="project-tile project-tile--mevora reveal" data-reveal>
                    <div class="project-tile__viz" aria-hidden="true">
                        <div class="viz viz--mevora"><i></i><i></i><i></i></div>
                    </div>
                    <p class="project-tile__tag">Ürün</p>
                    <h3>Mevora</h3>
                    <p>
                        Asıl ürün hattı. Mobil + web birlikte; portföyde ekranlar ve canlı link geldikçe burası dolacak.
                        Sadece .NET değil — ürünün kendisi.
                    </p>
                    <span class="text-link text-link--muted">Geliştiriliyor</span>
                </article>

                <article class="project-tile reveal" data-reveal>
                    <div class="project-tile__viz" aria-hidden="true">
                        <div class="viz viz--mobile"><em></em></div>
                    </div>
                    <p class="project-tile__tag">Mobil · Flutter</p>
                    <h3>personal-Finance-Tracker</h3>
                    <p>Flutter ile kişisel finans takip uygulaması — harcama / bütçe mobil deneyimi.</p>
                    <a class="text-link" href="https://github.com/HalilMertDeveli/personal-Finance-Tracker" target="_blank" rel="noopener noreferrer">GitHub →</a>
                </article>

                <article class="project-tile reveal" data-reveal>
                    <div class="project-tile__viz" aria-hidden="true">
                        <div class="viz viz--mobile"><em></em></div>
                    </div>
                    <p class="project-tile__tag">Mobil · Flutter</p>
                    <h3>FlutterVpnApp</h3>
                    <p>Flutter ile tasarlayıp kodladığım VPN uygulama denemesi.</p>
                    <a class="text-link" href="https://github.com/HalilMertDeveli/FlutterVpnApp" target="_blank" rel="noopener noreferrer">GitHub →</a>
                </article>

                <article class="project-tile reveal" data-reveal>
                    <div class="project-tile__viz" aria-hidden="true">
                        <div class="viz viz--mobile"><em></em></div>
                    </div>
                    <p class="project-tile__tag">Mobil · Kotlin</p>
                    <h3>VPNAppWithCompose</h3>
                    <p>Jetpack Compose ile VPN arayüz / akış — Android native mobil.</p>
                    <a class="text-link" href="https://github.com/HalilMertDeveli/VPNAppWithCompose" target="_blank" rel="noopener noreferrer">GitHub →</a>
                </article>

                <article class="project-tile reveal" data-reveal>
                    <div class="project-tile__viz" aria-hidden="true">
                        <div class="viz viz--ledger"><span></span><span></span><span></span><span></span></div>
                    </div>
                    <p class="project-tile__tag">.NET + Flutter</p>
                    <h3>ClearPay</h3>
                    <p>ASP.NET Core 8 web + Flutter JWT mobil istemci; SQL ledger, idempotent transfer.</p>
                    <a class="text-link" href="https://github.com/HalilMertDeveli/clearpay" target="_blank" rel="noopener noreferrer">GitHub →</a>
                </article>

                <article class="project-tile reveal" data-reveal>
                    <div class="project-tile__viz" aria-hidden="true">
                        <div class="viz viz--onion"><i></i><i></i><i></i></div>
                    </div>
                    <p class="project-tile__tag">ASP.NET Core</p>
                    <h3>Task Management · LED</h3>
                    <p>Bitirme (Onion MVC), LED saha / teknik destek ve banka–e-ticaret senaryoları.</p>
                    <a class="text-link" href="#one-cikan">Öne çıkan →</a>
                </article>
            </div>
        </div>
    </section>

    <section id="github" class="section section--github">
        <div class="section__inner">
            <p class="section__eyebrow reveal" data-reveal>GitHub · Repositories</p>
            <h2 class="section__title reveal" data-reveal>Repositories altındaki işlerim</h2>
            <p class="section__copy reveal" data-reveal>
                Profildeki
                <a class="inline-link" href="@Model.GitHubReposUrl" target="_blank" rel="noopener noreferrer">Repositories</a>
                sekmesindeki gerçek repolar. En üstte bu portföy sitesi;
                ardından ClearPay, bitirme projesi ve LED / finans çalışmaları@(Model.ReposFromApi ? " (canlı API)" : "").
            </p>

            <ol class="gh-steps" aria-label="GitHub yolculuğu">
                <li class="gh-step reveal" data-reveal>
                    <span class="gh-step__num">01</span>
                    <div>
                        <h3>Keşif</h3>
                        <p>Flutter, Kotlin, Spring ve C# ile temel atılan öğrenme repoları.</p>
                    </div>
                </li>
                <li class="gh-step reveal" data-reveal>
                    <span class="gh-step__num">02</span>
                    <div>
                        <h3>Derinleşme</h3>
                        <p>Identity, EF Core, n-katman, e-ticaret / banka senaryoları.</p>
                    </div>
                </li>
                <li class="gh-step reveal" data-reveal>
                    <span class="gh-step__num">03</span>
                    <div>
                        <h3>Ürün &amp; mülakat</h3>
                        <p>ClearPay ledger, Task Management bitirme, LED saha yazılımları.</p>
                    </div>
                </li>
            </ol>

            <div class="gh-grid">
                @foreach (var repo in Model.Repos)
                {
                    repoIndex++;
                    var isThisSite = string.Equals(repo.Name, "kisisel-portfolyo", StringComparison.OrdinalIgnoreCase);
                    <a class="gh-card @(isThisSite ? "gh-card--featured" : "") reveal" data-reveal data-tilt href="@repo.Url" target="_blank" rel="noopener noreferrer">
                        <div class="gh-card__top">
                            <span class="gh-card__index">@repoIndex.ToString("00")</span>
                            <span class="gh-card__lang">@(isThisSite ? "Bu site" : (repo.Language ?? "Repo"))</span>
                        </div>
                        <h3>@repo.Name</h3>
                        <p>@(repo.Description ?? "GitHub üzerinde açık kaynak çalışma.")</p>
                        <div class="gh-card__meta">
                            <span>★ @repo.Stars</span>
                            @if (!string.IsNullOrEmpty(repo.UpdatedAt))
                            {
                                <span>@repo.UpdatedAt</span>
                            }
                            <span class="gh-card__cta">Repoyu aç →</span>
                        </div>
                    </a>
                }
            </div>

            <div class="gh-cta reveal" data-reveal>
                <a class="btn btn--primary" href="@Model.GitHubReposUrl" target="_blank" rel="noopener noreferrer" data-magnetic>
                    GitHub Repositories’e git
                </a>
            </div>
        </div>
    </section>

    <section id="one-cikan" class="section section--spotlight">
        <div class="section__inner">
            <p class="section__eyebrow reveal" data-reveal>Öne çıkan analiz</p>
            <h2 class="section__title reveal" data-reveal>Projelerden çıkan hikâyeler</h2>
            <p class="section__copy reveal" data-reveal>
                GitHub’daki işleri okuyup buraya indirdim — mülakat, bitirme, saha ve mobil.
            </p>

            <div class="spotlight-list">
                <article class="spotlight reveal" data-reveal>
                    <div class="spotlight__visual" aria-hidden="true">
                        <div class="viz viz--ledger">
                            <span></span><span></span><span></span><span></span>
                        </div>
                    </div>
                    <div class="spotlight__body">
                        <p class="spotlight__tag">Mülakat reposu</p>
                        <h3>ClearPay</h3>
                        <p>
                            ASP.NET Core 8 + Flutter demo cüzdan. Bakiye kolonu yok; <strong>LedgerPair.NetOf</strong> ile türetilen bakiye,
                            idempotent HTTP, fake banka gateway, TR/EN/DE/FR arayüz. Softtech / Intertech mülakatında savunduğum repo.
                        </p>
                        <a class="text-link" href="https://github.com/HalilMertDeveli/clearpay" target="_blank" rel="noopener noreferrer">clearpay →</a>
                    </div>
                </article>

                <article class="spotlight reveal" data-reveal>
                    <div class="spotlight__visual" aria-hidden="true">
                        <div class="viz viz--onion">
                            <i></i><i></i><i></i>
                        </div>
                    </div>
                    <div class="spotlight__body">
                        <p class="spotlight__tag">Bitirme projesi</p>
                        <h3>Task Management System</h3>
                        <p>
                            Onion mimarili ASP.NET Core MVC. Admin paneli, üye görevleri, öncelikler, bildirimler, MediatR ve cookie auth ile
                            uçtan uca dikey dilim.
                        </p>
                        <a class="text-link" href="https://github.com/HalilMertDeveli/TaskManagementSystem" target="_blank" rel="noopener noreferrer">TaskManagementSystem →</a>
                    </div>
                </article>

                <article class="spotlight reveal" data-reveal>
                    <div class="spotlight__visual" aria-hidden="true">
                        <div class="viz viz--led">
                            <b></b><b></b><b></b><b></b><b></b><b></b>
                        </div>
                    </div>
                    <div class="spotlight__body">
                        <p class="spotlight__tag">Saha / LED</p>
                        <h3>LED uygulamaları</h3>
                        <p>
                            Colorlight ekosistemine yakın LED web ve teknik destek işleri —
                            <em>ASP.NET-APP-FOR-LED</em> ve <em>led-teknik-destek</em> (Novastar, Huudi).
                        </p>
                        <a class="text-link" href="https://github.com/HalilMertDeveli/ASP.NET-APP-FOR-LED" target="_blank" rel="noopener noreferrer">ASP.NET-APP-FOR-LED →</a>
                    </div>
                </article>

                <article class="spotlight reveal" data-reveal>
                    <div class="spotlight__visual" aria-hidden="true">
                        <div class="viz viz--mobile">
                            <em></em>
                        </div>
                    </div>
                    <div class="spotlight__body">
                        <p class="spotlight__tag">Mobil</p>
                        <h3>Flutter &amp; Kotlin</h3>
                        <p>
                            Finans takipçisi, VPN (Flutter + Compose), e-ticaret Flutter ve Android Kotlin denemeleri —
                            ClearPay’in Flutter JWT istemcisiyle de mobil tarafı ürün dilimine bağlıyorum.
                        </p>
                        <a class="text-link" href="https://github.com/HalilMertDeveli/personal-Finance-Tracker" target="_blank" rel="noopener noreferrer">personal-Finance-Tracker →</a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section id="iletisim" class="section section--contact">
        <div class="section__inner section__inner--narrow">
            <p class="section__eyebrow reveal" data-reveal>İletişim</p>
            <h2 class="section__title reveal" data-reveal>Sana ulaşmak isteyenler buradan yazsın.</h2>
            <p class="section__copy reveal" data-reveal>
                İş ilanı, staj, freelance veya soru — mail yeterli. GitHub Repositories ve bu site referansın olsun.
            </p>
            <div class="contact-actions reveal" data-reveal>
                <a class="btn btn--primary" href="mailto:halilmertdeveliii&#64;gmail.com" data-magnetic>E-posta gönder</a>
                <a class="btn btn--ghost" href="@Model.GitHubProfileUrl" rel="noopener noreferrer" target="_blank" data-magnetic>GitHub profil</a>
            </div>
            <p class="contact-email reveal" data-reveal>
                <a href="mailto:halilmertdeveliii&#64;gmail.com">halilmertdeveliii&#64;gmail.com</a>
            </p>
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="site-footer__inner">
        <p>© @DateTime.UtcNow.Year Halil Mert Develi · İstanbul</p>
        <p>ASP.NET Core 8 · CV / portföy</p>
    </div>
</footer>
