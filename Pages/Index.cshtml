@page "{lang:regex(^en$)?}"
@model IndexModel
@{
    ViewData["Lang"] = Model.LangCode;
    ViewData["Title"] = Model.PageTitle;
    ViewData["Description"] = Model.MetaDescription;
    ViewData["Canonical"] = Model.CanonicalUrl;
    ViewData["JsonLd"] = Model.JsonLd;
}

<partial name="Sections/_Nav" model="Model" />

<main id="main">
    <partial name="Sections/_Hero" model="Model" />

    <section id="work" class="section section--work" aria-labelledby="work-title">
        <div class="container">
            <header class="section-head" data-reveal>
                <p class="eyebrow"><span class="eyebrow__index">01</span>@Model.T("Seçili işler", "Selected work")</p>
                <h2 id="work-title" class="section-title">@Model.T("Ürettiğim ürünler ve sistemler", "Products and systems I've engineered")</h2>
                <p class="section-lead">
                    @Model.T(
                        "Üç vaka çalışması: problem, benim katkım, mühendislik kararları ve projenin bugünkü durumu. Biten ile planlanan ayrı gösterilir.",
                        "Three case studies covering the problem, my contribution, the engineering decisions and where each project stands today. Shipped and planned work are shown separately.")
                </p>
            </header>

            <div class="cases">
                @for (var i = 0; i < PortfolioContent.CaseStudies.Count; i++)
                {
                    <partial name="Sections/_CaseStudy" model="new CaseStudyView(Model, PortfolioContent.CaseStudies[i], i + 1)" />
                }
            </div>
        </div>
    </section>

    <partial name="Sections/_MoreProjects" model="Model" />
    <partial name="Sections/_About" model="Model" />
    <partial name="Sections/_Skills" model="Model" />
    <partial name="Sections/_Journey" model="Model" />
    <partial name="Sections/_GitHub" model="Model" />
    <partial name="Sections/_Contact" model="Model" />
</main>

<partial name="Sections/_Footer" model="Model" />
