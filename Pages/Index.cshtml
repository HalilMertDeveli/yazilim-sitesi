@page "{lang:regex(^en$)?}"
@model IndexModel
@{
    ViewData["Lang"] = Model.LangCode;
    ViewData["Title"] = Model.PageTitle;
    ViewData["Description"] = Model.MetaDescription;
    ViewData["Canonical"] = Model.CanonicalUrl;
    ViewData["JsonLd"] = Model.JsonLd;
}

<div class="scroll-progress" aria-hidden="true" data-progress></div>
<div class="cursor-glow" aria-hidden="true" data-cursor></div>
<partial name="Sections/_Nav" model="Model" />

<main id="main">
    <partial name="Sections/_Wall" model="Model" />
    <partial name="Sections/_Proof" model="Model" />

    <div class="led-ticker" aria-hidden="true">
        <canvas data-ticker="MEVORA  ///  LED B2B PLATFORM  ///  MOTOR  ///  LED SUPPORT BOT  ///  CLEARPAY  ///  "></canvas>
    </div>

    <section id="work" class="section section--work" aria-labelledby="work-title">
        <div class="container">
            <header class="section-head" data-reveal>
                <p class="eyebrow"><span class="eyebrow__index">01</span>@Model.T("Ürünler", "Products")</p>
                <h2 id="work-title" class="section-title section-title--xl">@Model.T("Okumakla kalma, dene.", "Don't just read. Try it.")</h2>
                <p class="section-lead">
                    @Model.T(
                        "Dört ürün, dört küçük demo. Her birinin ne işe yaradığını burada görüp kurcalayabilirsin; teknik ayrıntılar bir tık ötede.",
                        "Four products, four small demos. See what each one does and play with it right here; the technical depth is one click away.")
                </p>
            </header>
        </div>

        <div class="products">
            @for (var i = 0; i < PortfolioContent.CaseStudies.Count; i++)
            {
                <partial name="Sections/_Product" model="new CaseStudyView(Model, PortfolioContent.CaseStudies[i], i + 1)" />
            }
        </div>
    </section>

    <partial name="Sections/_MoreProjects" model="Model" />
    <partial name="Sections/_About" model="Model" />
    <partial name="Sections/_Skills" model="Model" />
    <partial name="Sections/_Journey" model="Model" />
    <partial name="Sections/_GitHub" model="Model" />
    <partial name="Sections/_Contact" model="Model" />
</main>

<partial name="Sections/_Footer" model="Model" />
<partial name="Sections/_Brief" model="Model" />
